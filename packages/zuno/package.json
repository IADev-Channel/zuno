{
	"name": "@iadev93/zuno",
	"version": "0.0.14",
	"author": "Ibrahim Aftab",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": false,
	"engines": {
		"node": ">=18"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./server": {
			"types": "./dist/server/index.d.ts",
			"import": "./dist/server/index.js",
			"require": "./dist/server/index.cjs"
		}
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch"
	},
	"keywords": [
		"state",
		"state-management",
		"sync",
		"sse",
		"server-sent-events",
		"broadcastchannel",
		"distributed-state",
		"event-sourcing",
		"universal-state",
		"realtime"
	],
	"homepage": "https://github.com/IADev-Channel/zuno",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/IADev-Channel/zuno.git"
	},
	"devDependencies": {
		"tsup": "^8.5.1"
	}
}
