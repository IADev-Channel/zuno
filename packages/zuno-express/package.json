{
	"name": "@iadev93/zuno-express",
	"version": "0.2.0",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": false,
	"engines": {
		"node": ">=22"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@iadev93/zuno": "workspace:*",
		"express": "^5.0.0"
	},
	"devDependencies": {
		"@iadev93/zuno": "workspace:*",
		"@types/express": "^5.0.0",
		"@types/node": "^22.0.0",
		"@typescript/native": "npm:typescript@7.0.2",
		"tsup": "^8.5.1",
		"typescript": "npm:@typescript/typescript6@6.0.2"
	},
	"keywords": [
		"zuno",
		"express",
		"state",
		"state-management",
		"sync",
		"sse",
		"server-sent-events",
		"broadcastchannel",
		"distributed-state",
		"event-sourcing",
		"universal-state",
		"realtime"
	],
	"homepage": "https://github.com/IADev-Channel/zuno",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/IADev-Channel/zuno.git"
	},
	"author": "Ibrahim Aftab",
	"license": "MIT"
}
