		"@angular/platform-browser": "^22.1.4",
		"@iadev93/zuno": "workspace:*",
		"@types/node": "^22.20.1",
		"rxjs": "^7.8.0",
		"tsup": "^8.5.1",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"zone.js": "~0.16.0"
	},
	"keywords": [
		"zuno",
		"angular",
		"state",
		"state-management",
		"sync",
