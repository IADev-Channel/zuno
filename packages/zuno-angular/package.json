{
	"name": "@iadev93/zuno-angular",
	"version": "0.0.3",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": false,
	"engines": {
		"node": ">=22"
	},
	"files": [
